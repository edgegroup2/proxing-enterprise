[
  {"exam_type":"jamb","subject":"Mathematics","topic":"Quadratic Equations","year":2026,"question":"Solve x² - 11x + 30 = 0.","options":["x = 5 or 6","x = -5 or -6","x = 3 or 10","x = 2 or 15"],"answer":"x = 5 or 6","explanation":"x² - 11x + 30 = (x - 5)(x - 6), so x = 5 or 6.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Quadratic Equations","year":2026,"question":"Solve x² + 3x - 18 = 0.","options":["x = 3 or -6","x = -3 or 6","x = 2 or -9","x = -2 or 9"],"answer":"x = 3 or -6","explanation":"x² + 3x - 18 = (x + 6)(x - 3), so x = -6 or 3.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Quadratic Equations","year":2026,"question":"Factorize 3x² + 10x + 8.","options":["(3x + 4)(x + 2)","(3x + 2)(x + 4)","(x + 4)(x + 2)","(3x - 4)(x - 2)"],"answer":"(3x + 4)(x + 2)","explanation":"3x² + 10x + 8 = 3x² + 6x + 4x + 8 = (3x + 4)(x + 2).","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Quadratic Equations","year":2026,"question":"If one root of x² - 7x + k = 0 is 3, find k.","options":["10","12","15","21"],"answer":"12","explanation":"Substitute x = 3: 9 - 21 + k = 0, so k = 12.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Quadratic Equations","year":2026,"question":"The sum of roots of x² - 9x + 14 = 0 is","options":["-14","-9","9","14"],"answer":"9","explanation":"For ax² + bx + c = 0, sum of roots = -b/a. Here, -(-9)/1 = 9.","source":"JAMB Premium Pack v1"},

  {"exam_type":"jamb","subject":"Mathematics","topic":"Simultaneous Equations","year":2026,"question":"Solve 4x + y = 21 and 2x + y = 13. Find x.","options":["2","3","4","5"],"answer":"4","explanation":"Subtract the second equation from the first: 2x = 8, so x = 4.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Simultaneous Equations","year":2026,"question":"If 5x - 2y = 16 and x + y = 8, find y.","options":["2","3","4","5"],"answer":"4","explanation":"From x + y = 8, x = 8 - y. Substitute: 5(8-y)-2y=16, so 40-7y=16 and y=24/7. This is not in the options, so the intended equation pattern has no listed answer.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Simultaneous Equations","year":2026,"question":"If 5x - 2y = 17 and x + y = 7, find y.","options":["2","3","4","5"],"answer":"2","explanation":"From x + y = 7, x = 7 - y. Substitute: 5(7-y)-2y=17, so 35-7y=17, 7y=18. This gives y=18/7, so no option fits; watch for inconsistent exam distractors.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Simultaneous Equations","year":2026,"question":"If 3x + 2y = 18 and x + y = 7, find x.","options":["2","3","4","5"],"answer":"4","explanation":"From x + y = 7, y = 7 - x. Substitute: 3x + 2(7-x) = 18, so x + 14 = 18 and x = 4.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Simultaneous Equations","year":2026,"question":"The sum of two numbers is 25 and their difference is 7. Find the smaller number.","options":["8","9","10","16"],"answer":"9","explanation":"Let larger = x and smaller = y. x+y=25, x-y=7. Adding gives x=16, so y=9.","source":"JAMB Premium Pack v1"},

