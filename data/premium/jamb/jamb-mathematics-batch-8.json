  {"exam_type":"jamb","subject":"Mathematics","topic":"Variation","year":2026,"question":"If y varies directly as x and y=48 when x=12, find x when y=20.","options":["4","5","6","8"],"answer":"5","explanation":"y=kx. k=48/12=4. If y=20, then 20=4x, so x=5.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Variation","year":2026,"question":"If y varies inversely as x and y=15 when x=4, find x when y=10.","options":["4","5","6","8"],"answer":"6","explanation":"xy=k. k=15×4=60. If y=10, x=60/10=6.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Variation","year":2026,"question":"If z varies directly as x and inversely as y, z=6 when x=4 and y=2. Find z when x=10 and y=5.","options":["4","6","8","10"],"answer":"6","explanation":"z=kx/y. 6=k(4/2), so k=3. For x=10,y=5: z=3(10/5)=6.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Variation","year":2026,"question":"If y varies as the square root of x and y=6 when x=9, find y when x=25.","options":["8","10","12","15"],"answer":"10","explanation":"y=k√x. 6=3k, so k=2. When x=25, y=2×5=10.","source":"JAMB Premium Pack v1"},
  {"exam_type":"jamb","subject":"Mathematics","topic":"Variation","year":2026,"question":"If p varies inversely as q² and p=9 when q=2, find p when q=6.","options":["1","2","3","6"],"answer":"1","explanation":"pq²=k. k=9×4=36. When q=6, p=36/36=1.","source":"JAMB Premium Pack v1"},

