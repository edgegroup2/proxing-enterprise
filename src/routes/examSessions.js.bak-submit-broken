      error: err.message || 'Failed to fetch history'
    });
  }
});

/**
 * Review session
 * GET /api/exam-sessions/:session_id
 */
router.get('/:session_id', async (req, res) => {
  try {
    const { session_id } = req.params;

    const session = await db.query(`
      SELECT *
      FROM exam_sessions
      WHERE id = $1
      LIMIT 1
    `, [session_id]);

    if (!session.rows.length) {
      return res.status(404).json({
        success: false,
        error: 'Session not found'
      });
    }

    const review = await db.query(`
      SELECT
        sqa.question_id,
        q.stem,
        q.explanation,
        q.topic_id,
        t.name AS topic,
        sqa.selected_option_id,
        sqa.is_correct,
        sqa.response_time,

        (
          SELECT id
          FROM question_options
          WHERE question_id = q.id
          AND is_correct = true
          LIMIT 1
        ) AS correct_option_id,

        (
          SELECT text
          FROM question_options
          WHERE id = sqa.selected_option_id
          LIMIT 1
        ) AS selected_option_text,

        (
          SELECT text
          FROM question_options
          WHERE question_id = q.id
          AND is_correct = true
          LIMIT 1
        ) AS correct_option_text

      FROM student_question_attempts sqa
      JOIN questions q ON q.id = sqa.question_id
      LEFT JOIN topics t ON t.id = q.topic_id

      WHERE sqa.exam_session_id = $1

      ORDER BY sqa.created_at ASC
    `, [session_id]);

    return res.json({
      success: true,
      data: {
        session: session.rows[0],
        review: review.rows
      }
    });

  } catch (err) {
    console.error('[SESSION_REVIEW_ERROR]', err);

    return res.status(500).json({
      success: false,
      error: err.message || 'Failed to fetch review'
    });
  }
});

/**
 * Topic mastery analytics
 * GET /api/exam-sessions/topics/:student_id
 */
router.get('/topics/:student_id', async (req, res) => {
  try {
    const { student_id } = req.params;

    const result = await db.query(
      `
      SELECT
        COALESCE(sqa.topic_name, t.name, 'Unknown') AS topic,
        COUNT(*)::int AS attempts,
        SUM(CASE WHEN sqa.is_correct THEN 1 ELSE 0 END)::int AS correct,
        ROUND(
          100.0 * SUM(CASE WHEN sqa.is_correct THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0),
          2
        ) AS accuracy
      FROM student_question_attempts sqa
      LEFT JOIN topics t ON t.id = sqa.topic_id
      WHERE sqa.student_id = $1
        AND COALESCE(sqa.topic_name, t.name, '') <> ''
      GROUP BY COALESCE(sqa.topic_name, t.name, 'Unknown')
      HAVING COUNT(*) >= 5
      ORDER BY accuracy DESC, attempts DESC
      `,
      [student_id]
    );

    const rows = result.rows;

    const strongest = rows
      .filter((r) => Number(r.accuracy) >= 60)
      .slice(0, 5);

    const weakest = rows
      .filter((r) => Number(r.accuracy) < 60)
      .sort((a, b) => Number(a.accuracy) - Number(b.accuracy))
      .slice(0, 5);

    return res.json({
      success: true,
      data: {
        strongest,
        weakest,
        all_topics: rows
      }
    });
  } catch (err) {
    console.error('[TOPIC_MASTERY_ERROR]', err);
    return res.status(500).json({
      success: false,
      error: err.message || 'Failed to fetch topic mastery'
    });
  }
});

module.exports = router;
