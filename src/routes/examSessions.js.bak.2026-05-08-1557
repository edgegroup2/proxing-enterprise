'use strict';

const express = require('express');
const router = express.Router();
const db = require('../db');

function clampLimit(value, fallback = 40, max = 100) {
  const n = parseInt(value || fallback, 10);
  if (Number.isNaN(n) || n < 1) return fallback;
  return Math.min(n, max);
}

function durationForExam(examType) {
  return examType === 'jamb' ? 40 : 60;
}

/**
 * Start exam session
 * GET /api/exam-sessions/start?exam_type=jamb&subject=Economics&limit=40
 */
router.get('/start', async (req, res) => {
  try {
    const examType = String(req.query.exam_type || '').toLowerCase();
    const subjectName = String(req.query.subject || '').trim();
    const studentId = req.query.student_id ? String(req.query.student_id) : null;
    const limit = clampLimit(req.query.limit, 40, 100);
    const durationMinutes = durationForExam(examType);

    if (!examType || !subjectName) {
      return res.status(400).json({
        success: false,
        error: 'exam_type and subject are required',
      });
    }

    const questions = await db.query(
      `
      SELECT
        q.id,
        q.stem,
        q.explanation,
        q.difficulty,
        q.year,
        q.source,
        q.topic_id,
        t.name AS topic,
        COALESCE(
          json_agg(
            json_build_object(
              'id', qo.id,
              'label', qo.label,
              'text', qo.text
            )
            ORDER BY random()
          ) FILTER (WHERE qo.id IS NOT NULL),
          '[]'
        ) AS options
      FROM questions q
      JOIN subjects s ON s.id = q.subject_id
      LEFT JOIN topics t ON t.id = q.topic_id
      LEFT JOIN question_options qo ON qo.question_id = q.id
      WHERE lower(s.exam_type) = lower($1)
        AND lower(s.name) = lower($2)
        AND q.is_active = true
      GROUP BY q.id, t.name
      HAVING COUNT(qo.id) >= 2
      ORDER BY random()
      LIMIT $3
      `,
      [examType, subjectName, limit]
    );

    let sessionId = null;
    let expiresAt = null;

    if (studentId) {
      const studentCheck = await db.query(
        'SELECT id FROM users WHERE id = $1 LIMIT 1',
        [studentId]
      );

      if (studentCheck.rows.length) {
        const session = await db.query(
          `
          INSERT INTO exam_sessions (
            student_id,
            exam_type,
            subject,
            total_questions,
            duration_minutes,
            status,
            expires_at
          )
          VALUES (
            $1, $2, $3, $4, $5,
            'in_progress',
            now() + ($5::int * interval '1 minute')
          )
          RETURNING id, expires_at
          `,
          [studentId, examType, subjectName, questions.rows.length, durationMinutes]
        );

        sessionId = session.rows[0].id;
        expiresAt = session.rows[0].expires_at;
      } else {
        console.warn('[EXAM_SESSION_START] Invalid student_id ignored:', studentId);
      }
    }

    return res.json({
      success: true,
      data: {
        session_id: sessionId,
        exam_type: examType,
        subject: subjectName,
        question_count: questions.rows.length,
        duration_minutes: durationMinutes,
        expires_at: expiresAt,
        questions: questions.rows,
      },
    });
  } catch (err) {
    console.error('[EXAM_SESSION_START_ERROR]', err);
    return res.status(500).json({
      success: false,
      error: err.message || 'Failed to start exam session',
    });
  }
});

/**
 * Submit exam answers
 * POST /api/exam-sessions/submit
 */
router.post('/submit', async (req, res) => {
  try {
    const { student_id, session_id, answers } = req.body || {};

    if (!student_id || !Array.isArray(answers)) {
      return res.status(400).json({
        success: false,
        error: 'student_id and answers array are required',
      });
    }

    if (!answers.length) {
      return res.status(400).json({
        success: false,
        error: 'answers array cannot be empty',
      });
    }

    const examType = answers[0]?.exam_type || 'jamb';
    const subject = answers[0]?.subject || 'General';
    const durationMinutes = durationForExam(String(examType).toLowerCase());

    let examSessionId = session_id || null;

    if (examSessionId) {
      const existingSession = await db.query(
        `
        SELECT id, status, expires_at
        FROM exam_sessions
        WHERE id = $1
          AND student_id = $2
        LIMIT 1
        `,
        [examSessionId, student_id]
      );

      if (!existingSession.rows.length) {
        return res.status(404).json({
          success: false,
          error: 'Exam session not found',
        });
      }

      if (existingSession.rows[0].status === 'completed') {
        return res.status(400).json({
          success: false,
          error: 'Exam session already completed',
        });
      }

      if (
        existingSession.rows[0].expires_at &&
        new Date(existingSession.rows[0].expires_at).getTime() < Date.now()
      ) {
        await db.query(
          `UPDATE exam_sessions SET status = 'expired', completed_at = now() WHERE id = $1`,
          [examSessionId]
        );

        return res.status(400).json({
          success: false,
          error: 'Exam session expired',
        });
      }
    } else {
      const sessionResult = await db.query(
        `
        INSERT INTO exam_sessions (
          student_id,
          exam_type,
          subject,
          total_questions,
          duration_minutes,
          status,
          expires_at
        )
VALUES (
  $1, $2, $3, $4, $5,
  'in_progress',
  now() + ($5::int * interval '1 minute')
)
RETURNING id
        `,
        [student_id, examType, subject, answers.length, durationMinutes]
      );

      examSessionId = sessionResult.rows[0].id;
    }

    let correct = 0;
    const review = [];

    for (const answer of answers) {
      const questionId = answer.question_id;
      const selectedOptionId = answer.selected_option_id || null;
      const responseTime = answer.response_time || answer.response_time_sec || 0;

      const result = await db.query(
        `
        SELECT
          q.id,
          q.stem,
          q.explanation,
          q.topic_id,
          q.subject_id,
          qo.id AS option_id,
          qo.label,
          qo.text,
          qo.is_correct
        FROM questions q
        JOIN question_options qo ON qo.question_id = q.id
        WHERE q.id = $1::uuid
        `,
        [questionId]
      );

      if (!result.rows.length) {
        review.push({
          question_id: questionId,
          error: 'Question not found',
        });
        continue;
      }

      const options = result.rows;
      const selected = options.find(
        (o) => String(o.option_id) === String(selectedOptionId)
      );
      const correctOption = options.find((o) => o.is_correct === true);
      const isCorrect = Boolean(selected && selected.is_correct === true);

      if (isCorrect) correct += 1;

      await db.query(
        `
        INSERT INTO student_question_attempts (
          exam_session_id,
          user_id,
          student_id,
          question_id,
          topic_id,
          subject_id,
          selected_option_id,
          is_correct,
          response_time,
          created_at
        )
        VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9,now())
        `,
        [
          examSessionId,
          student_id,
          student_id,
          questionId,
          options[0].topic_id || null,
          options[0].subject_id || null,
          selectedOptionId,
          isCorrect,
          responseTime,
        ]
      );

      review.push({
        question_id: questionId,
        stem: options[0].stem,
        selected_option_id: selectedOptionId,
        correct_option_id: correctOption ? correctOption.option_id : null,
        is_correct: isCorrect,
        explanation: options[0].explanation || null,
      });
    }

    const total = answers.length;
    const wrong = total - correct;
    const scorePercent = total
      ? Number(((correct / total) * 100).toFixed(2))
      : 0;

    await db.query(
      `
      UPDATE exam_sessions
      SET
        total_questions = $1,
        correct_answers = $2,
        wrong_answers = $3,
        score_percent = $4,
        completed_at = now(),
        status = 'completed'
      WHERE id = $5
      `,
      [total, correct, wrong, scorePercent, examSessionId]
    );

    return res.json({
      success: true,
      data: {
        session_id: examSessionId,
        attempt_id: examSessionId,
        total,
        correct,
        wrong,
        score_percent: scorePercent,
        review,
      },
    });
  } catch (err) {
    console.error('[EXAM_SESSION_SUBMIT_ERROR]', err);
    return res.status(500).json({
      success: false,
      error: err.message || 'Failed to submit exam session',
    });
  }
});

/**
 * Session history
 * GET /api/exam-sessions/history/:student_id
 */
router.get('/history/:student_id', async (req, res) => {
  try {
    const studentId = req.params.student_id;
    const limit = clampLimit(req.query.limit, 20, 100);

    const result = await db.query(
      `
      SELECT
        id,
        exam_type,
        subject,
        started_at,
        completed_at,
        duration_minutes,
        total_questions,
        correct_answers,
        wrong_answers,
        score_percent,
